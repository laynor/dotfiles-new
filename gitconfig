# -*- conf -*-
[user]
	name = Alessandro Piras
	email = laynor@gmail.com
[core]
	editor = vim
	preloadIndex = true
	autocrlf = input
	excludesfile = /home/ale/.gitignore_global
    # pager = delta
        # excludesfile = /home/mattia/.gitignore_global
        # sparsecheckout = true
[interactive]
  diffFilter = delta --color-only
[delta]
  features = side-by-side line-numbers decorations
  whitespace-error-style = 22 reverse
[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
[color]
	ui = auto
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[alias]
	st = status
	ci = commit
	co = checkout
	unstage = reset HEAD
    lg = log --graph --date=iso --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cs - %cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=iso
	dw = "!f() { length=$(($#-1)); for last; do true; done; git diff ${@:3:$length} `find . -name $1` $last; }; f"
    ls = "!cd -- ${GIT_PREFIX:-.};\nfor i in *; \ndo \n  ls -ld $i | awk 'BEGIN { ORS=\"\";} {print $1, $2, $3, $4; printf(\"%7s \",$5)}'; \n  gd=$(git log -1 --date=local --format=\"%ad\" -- \"$i\"); \n  [ -z \"$gd\" ] && gd=$(ls -ld \"$i\" | awk '{print $6, $7, $8}'); \n  if [ $(gdate -d \"$gd\" +%s) -le $(gdate -d \"6 months ago\" +%s) ] ; \n    then dfmt='%b %_d  %Y'; \n    else dfmt='%b %_d %H:%M'; \n  fi; \n  printf \"%s \" \"$(gdate -d \"$gd\" +\"$dfmt\")\"; \n  ls -d --color=always \"$i\"; \ndone"
	faust = "!b=$(git symbolic-ref refs/remotes/origin/HEAD | sed \"s@^refs/remotes/origin/@@\"); git fetch origin $b:$b"
[merge]
	conflictstyle = diff3
[receive]
	# The receive.denyNonFastforwards flag makes sure that merges can't
	# happen when you push to the repo. You have to do the merges on your
	# local machine, and then push the result.
	# denyNonFastForwards = true
	# [branch]
	# 	autosetupmerge = true
[push]
	default = simple
[github]
	user = laynor
	oauth-token = 9cd10045199b37a83db8f3ea0531422e844f6d16
[magithub]
	online = false
[magithub "status"]
	includeStatusHeader = false
	includePullRequestsSection = false
	includeIssuesSection = false
[pull]
	ff = only
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[url "git@github.com:"]
	insteadOf = https://github.com/
[diff]
	algorithm = histogram
